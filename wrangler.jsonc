{
  // Deploy en Cloudflare Workers como sitio estático (Next.js con output: 'export').
  // "name" debe coincidir exactamente con el nombre del proyecto en Cloudflare.
  "name": "zajux",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page"
  }
}
